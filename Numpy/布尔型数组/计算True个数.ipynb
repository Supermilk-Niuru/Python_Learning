     ]
    }
   ],
   "source": [
    "# sum() 计算True个数\n",
    "# any() 输出结果为True或者False 只要有True，结果就为True\n",
    "# all() 全为True才返回True\n",
    "arr3 = arr1>=arr2\n",
    "print(arr3)\n",
    "print(np.sum(arr3))\n",
    "print(np.any(arr3))"
   ]
  }

     ]
    }
   ],
   "source": [
    "arr1 = np.arange(10).reshape(2,5)\n",
    "print(arr1)\n",
    "# >= <= != > < == 等关系运算符\n",
    "# 还可以多个条件进行比较 与 & 或 ｜ 非 ～ Numpy里面这样使用 \n",
    "# 但Python里面使用 and or not\n",
    "arr2 = arr1>=4\n",
    "print(arr2)"
   ]
  },
